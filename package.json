{
  "name": "research-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explains hard PDFs chapter by chapter with highlights and handwritten notes: Chrome extension, localhost web app and a Claude Code plugin, powered by your local Claude Code.",
  "scripts": {
    "setup": "node scripts/vendor.mjs",
    "start": "node bridge/server.mjs",
    "bridge": "node bridge/server.mjs",
    "mobile": "node bridge/server.mjs --lan",
    "test": "node --test test/*.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:web": "node scripts/e2e-web.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "pdfjs-dist": "6.5.438",
    "playwright": "^1.57.0",
    "roughjs": "4.6.6"
  }
}
